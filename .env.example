# Storage mode: "json" (local dev, default) or "supabase"
# See supabase/migration.sql + SUPABASE_SETUP.md for the one-time setup.
STORAGE_MODE=json

# Session
SESSION_SECRET=change_this_to_a_long_random_string_in_production
# Optional override for the session cookie's Secure flag ("true" | "false").
# By default it's inferred from NEXT_PUBLIC_APP_URL (https:// -> secure).
# Only set this if your domain is behind a proxy that terminates TLS before
# the app sees the request (Secure would otherwise be wrongly disabled).
# COOKIE_SECURE=true

# Supabase (only needed when STORAGE_MODE=supabase)
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
